{
  "identifier": "default",
  "description": "Default capabilities for the Kimi desktop wrapper",
  "local": true,
  "remote": {
    "urls": ["https://kimi.ai", "https://www.kimi.ai", "https://kimi.moonshot.cn"]
  },
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "core:webview:allow-create-webview",
    "core:webview:allow-create-webview-window",
    "window-state:allow-restore-state",
    "window-state:allow-save-window-state"
  ]
}
